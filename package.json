{
  "name": "partner-app",
  "version": "1.0.0",
  "description": "",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test \"test/**/*.test.js\"",
    "build": "electron-builder --win --mac",
    "build:native": "node scripts/build-native.js",
    "test:native": "cargo test --manifest-path native/fp-print/Cargo.toml --lib",
    "smoke:print": "node scripts/smoke-print.js",
    "discover": "node scripts/discover.js",
    "smoke:add": "node scripts/smoke-add.js",
    "check:packaged": "node scripts/check-packaged.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "dns-packet": "^5.6.1",
    "electron-updater": "^6.8.9",
    "leaflet": "^1.9.4",
    "multicast-dns": "^7.2.5",
    "pdf-lib": "^1.17.1",
    "qrcode": "^1.5.4",
    "socket.io-client": "^4.8.4",
    "uuid": "^14.0.2"
  },
  "devDependencies": {
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.funprinting.partner",
    "productName": "FunPrinting Partner",
    "artifactName": "FunPrintingPartner-Setup.${ext}",
    "publish": [
      {
        "provider": "github",
        "owner": "FunPrinting",
        "repo": "partner-desktop"
      }
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icons/icon.ico"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "build/icons/icon.icns",
      "identity": null
    },
    "files": [
      "**/*",
      "!native/fp-print/target/**",
      "!native/fp-print/src/**",
      "!native/fp-print/Cargo.*",
      "!native/fp-print/build.rs",
      "!test/**",
      "!scripts/**",
      "!.github/**",
      "!dist/**"
    ],
    "asarUnpack": [
      "native/fp-print/fp-print.node",
      "native/fp-print/pdfium.dll"
    ],
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Utility",
      "icon": "build/icons"
    }
  }
}

{
  "name": "partner-app",
  "version": "1.0.0",
  "description": "",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win --mac"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "electron-updater": "^6.8.9",
    "pdf-lib": "^1.17.1",
    "socket.io-client": "^4.8.4"
  },
  "optionalDependencies": {
    "@thiagoelg/node-printer": "^2.2.1"
  },
  "devDependencies": {
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.funprinting.partner",
    "productName": "FunPrinting Partner",
    "artifactName": "FunPrintingPartner-Setup.${ext}",
    "publish": [
      {
        "provider": "github",
        "owner": "FunPrinting",
        "repo": "partner-desktop"
      }
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "mac": {
      "target": ["dmg", "zip"],
      "icon": "build/icon.png",
      "identity": null
    }
  }
}
